{
  "name": "convert",
  "version": "1.0.0",
  "private": true,
  "description": "Offline drag-and-wheel file converter and file-tools launcher for Windows",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "icons": "node --experimental-strip-types scripts/make-icons.mts",
    "licenses": "node scripts/make-licenses.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win nsis --x64 --publish never",
    "smoke": "node scripts/smoke.cjs"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.13",
    "@tailwindcss/vite": "^4.3.3",
    "@types/heic-convert": "^2.1.1",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "lucide-react": "^1.64.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zustand": "^5.0.16"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "@fontsource-variable/inter": "5.3.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@vladmandic/face-api": "^1.7.15",
    "7zip-bin": "^5.2.0",
    "docx": "^9.15.0",
    "exceljs": "^4.4.0",
    "exiftool-vendored": "^39.1.0",
    "ffmpeg-static": "^5.3.0",
    "heic-convert": "^2.1.0",
    "jszip": "^3.10.2",
    "koffi": "^3.3.5",
    "mammoth": "^1.13.0",
    "marked": "^18.1.2",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "turndown": "^7.2.4",
    "uiohook-napi": "^1.5.5",
    "zod": "^4.6.7"
  },
  "main": "out/main/index.js",
  "author": "Convert",
  "engines": {
    "node": ">=20.19"
  }
}
